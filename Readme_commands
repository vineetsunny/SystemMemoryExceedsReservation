oc get prometheusrules -A -o json | jq -r '
  .items[] as $rule |
  $rule.spec.groups[] as $group |
  $group.rules[] |
  select(.alert != null) |
  "Namespace: \($rule.metadata.namespace)\nAlert: \(.alert)\nExpression: \(.expr)\n---"


oc get prometheusrules -A -o json | jq -r '
  .items[] as $rule |
  $rule.spec.groups[] |
  .rules[] |
  select(.alert != null) |
  "Alert Name: \(.alert)\nExpression: \(.expr)\nDescription: \(.annotations.description // "N/A")\n---"
' | grep -A 2 -B 0 "Alert Name: KubePodCrashLooping"




oc get prometheusrules -A -o json | jq -r '
  ["Namespace", "Alert Name", "Severity", "Duration", "Expression"],
  (.items[] as $rule |
   $rule.spec.groups[] as $group |
   $group.rules[] |
   select(.alert != null) |
   [
     $rule.metadata.namespace,
     .alert,
     (.labels.severity // "N/A"),
     (.for // "N/A"),
     (.expr | tostring)
   ]) |
  @csv
' > openshift-4.22-alert-rules.csv


