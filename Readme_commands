check metrics are avialble or not?

while IFS= read -r metric; do
  [ -z "$metric" ] && continue

  result=$(oc exec -n openshift-monitoring prometheus-k8s-0 -- \
    curl -sG 'http://localhost:9090/api/v1/query' \
    --data-urlencode "query=count({__name__=\"$metric\"})")

  if echo "$result" | grep -q '"result":\[\]'; then
    echo "NOT FOUND | $metric"
  else
    count=$(echo "$result" | sed -n 's/.*"value":\[[^,]*,"\([^"]*\)"\].*/\1/p')
    echo "FOUND     | $metric | series=$count"
  fi
done < metrics.txt
